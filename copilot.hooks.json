{
  "//setup": "Save as .github/hooks/usage-tracking.json (repo/cloud agent, must be on default branch) or ~/.copilot/hooks/usage-tracking.json (user-level, CLI only). Requires COPILOT_HOOK_ALLOW_LOCALHOST=1 in the environment Copilot runs in, or it will silently refuse the http:// URL (Copilot only allows plain http to localhost/127.*/[::1] with that flag set; everything else must be https). Set a USER_EMAIL environment variable so events are attributed to you instead of landing as 'unknown'.",
  "//coverage": "SessionEnd and PostToolUseFailure are documented but newer additions - VS Code's hook surface has historically lagged the CLI/cloud agent event set. If they don't fire, check `copilot --print-debug-info` / your Copilot version against the hooks reference.",
  "version": 1,
  "hooks": {
    "SessionStart": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "SessionEnd": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "UserPromptSubmit": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "PreToolUse": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "PostToolUse": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "PostToolUseFailure": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "Stop": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "SubagentStart": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "SubagentStop": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ],
    "PreCompact": [
      { "type": "http", "url": "http://localhost:7071/api/hooks/copilot", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeoutSec": 10 }
    ]
  }
}
