{
  "//": "Merge this 'hooks' block into ~/.claude/settings.json (all projects) or .claude/settings.json (this project only). URL targets the local Function App (func default port 7071, route prefix /api). Adjust the port if you run func on a different one. Set a USER_EMAIL environment variable so events are attributed to you instead of landing as 'unknown'.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "http", "url": "http://localhost:7071/api/hooks/claude-code", "headers": { "X-User-Email": "$USER_EMAIL" }, "allowedEnvVars": ["USER_EMAIL"], "timeout": 10 } ] }
    ]
  }
}
