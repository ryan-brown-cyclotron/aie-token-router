        <mxCell id="e-mcp-daemon" value="project context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 4;strokeColor=#3756A3;fontFamily=Segoe UI;fontSize=10;fontColor=#48585F;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-mcp" target="n-daemon">
