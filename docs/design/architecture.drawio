        <mxCell id="e-func-dash" value="read API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#622E88;fontFamily=Segoe UI;fontSize=10;fontColor=#622E88;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-functions" target="n-dashboard">
