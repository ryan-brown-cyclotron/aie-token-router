{
  "//": "This repo's own GitHub Copilot hooks (repo-level: .github/hooks/*.json, must be on the default branch to apply to the cloud agent). Copilot delivers each event as JSON on stdin, so these command hooks pipe it straight to the locally-built CLI - no global install needed, just `dotnet build`. End users should instead use the PATH-based example in docs/onboarding/copilot.hooks.json. Event names use Copilot's canonical camelCase. Identity comes from the daemon's Entra token; no USER_EMAIL.",
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ],
    "userPromptSubmitted": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ],
    "preToolUse": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ],
    "errorOccurred": [
      { "type": "command", "bash": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "powershell": "dotnet src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll command copilot --stdin", "timeoutSec": 10 }
    ]
  }
}
