{
  "//": "This repo's own hooks target the locally-built CLI directly (no global 'usagetracker' install needed - just `dotnet build`). The CLI fails open if the daemon isn't running. End users should instead use the PATH-based examples in docs/onboarding/. Requires the Debug build of UsageTracker.Cli; run `dotnet build src/UsageTracker.sln` first.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll\" command claude-code --stdin",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll\" command claude-code --stdin",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll\" command claude-code --stdin",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll\" command claude-code --stdin",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/src/UsageTracker.Cli/bin/Debug/net8.0/usagetracker.dll\" command claude-code --stdin",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
