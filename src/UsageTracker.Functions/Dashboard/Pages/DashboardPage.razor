    private long _totalTokens;
    private long _maxProjectTokens;
    private string? _error;

    // ---- MudBlazor chart state ----
    private List<ChartSeries<double>> _usageSeries = new();
    private string[] _usageLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _modelSeries = new();
    private string[] _modelLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _projectSeries = new();
    private string[] _projectLabels = Array.Empty<string>();

    // Cyclotron palette applied to each chart's series
    private readonly LineChartOptions _lineOptions = new()
    {
        ChartPalette = new[] { "#60D8EE", "#622E88" },   // Sky Blue = total, Eminence = input
        InterpolationOption = InterpolationOption.NaturalSpline,
        LineStrokeWidth = 3
    };
    private readonly DonutChartOptions _donutOptions = new()
    {
        ChartPalette = new[] { "#3756A3", "#60D8EE", "#622E88", "#F38826", "#A9D23D" }
    };
    private readonly BarChartOptions _barOptions = new()
    {
        ChartPalette = new[] { "#3756A3" }   // True Blue bars
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sessions = Dashboard.Sessions();
            _projects = await Dashboard.ProjectsAsync(null, null);
            _usage = await Dashboard.UsageAsync(null, null);
            _totalTokens = _projects.Sum(p => p.TotalTokens);
            _maxProjectTokens = _projects.Count > 0 ? _projects.Max(p => p.TotalTokens) : 0;
            BuildCharts();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void BuildCharts()
    {
        // Model split — REAL: grouped straight from the usage rollup.
        var byModel = _usage
            .GroupBy(u => u.Model)
            .Select(g => new { Model = g.Key, Tokens = g.Sum(x => x.InputTokens + x.OutputTokens) })
            .OrderByDescending(x => x.Tokens)
            .ToList();
        _modelLabels = byModel.Select(x => x.Model ?? "unknown").ToArray();
        _modelSeries = new()
        {
            new ChartSeries<double> { Name = "Tokens", Data = byModel.Select(x => (double)x.Tokens).ToArray() }
        };

        // Top projects — REAL: from the projects rollup, tokens in millions.
        var top = _projects.OrderByDescending(p => p.TotalTokens).Take(6).ToList();
        _projectLabels = top.Select(p => p.ProjectName).ToArray();
        _projectSeries = new()
        {
            new ChartSeries<double> { Name = "Tokens (M)", Data = top.Select(p => Math.Round(p.TotalTokens / 1_000_000d, 2)).ToArray() }
        };

        // Usage over time — needs a daily time-series your service doesn't expose yet.
        // Replace this sample with e.g.  await Dashboard.DailyTotalsAsync(from, to);
        _usageLabels = new[] { "Jul 4", "Jul 5", "Jul 6", "Jul 7", "Jul 8", "Jul 9", "Jul 10" };
        _usageSeries = new()
        {
            new ChartSeries<double> { Name = "Total", Data = new double[] { 3.2, 2.9, 4.4, 5.0, 4.7, 5.4, 5.8 } },
            new ChartSeries<double> { Name = "Input", Data = new double[] { 2.4, 2.2, 3.3, 3.7, 3.5, 4.0, 4.3 } }
        };
    }

    // Compact token formatting: 1_240_000 -> "1.2M"
    private static string Short(long n) =>
        n >= 1_000_000 ? (n / 1_000_000d).ToString("0.#") + "M"
        : n >= 1_000    ? (n / 1_000d).ToString("0") + "K"
        : n.ToString();

    private static string Conf(string? c) => (c ?? "").ToLowerInvariant() switch
    {
        "high" => "high",
        "medium" => "med",
        "low" => "low",
        _ => "med"
    };

    private static string PlatformColor(string? platform) => (platform ?? "") switch
    {
        "Claude Code" => "#60D8EE",
        "Cursor" => "#622E88",
        "GitHub Copilot" => "#3756A3",
        "Windsurf" => "#F38826",
        _ => "#9aa2bf"
    };
