@* Plain wrapper component (not a LayoutComponentBase) - there's no Blazor Router in this
   HtmlRenderer-only, non-interactive hosting model, so pages compose this directly as
   <DashboardLayout Title="..."><!-- content --></DashboardLayout> rather than via @page/@layout. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Title - UsageTracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <style>
        html, body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
        .page { position: relative; display: flex; flex-direction: column; }
        main { flex: 1; }
        .content { padding-top: 1.1rem; }
        code { color: #c02d76; }

        @@media (min-width: 641px) {
            .page { flex-direction: row; }
        }
    </style>
</head>
<body>
    <div class="page">
        <main>
            <article>
                @ChildContent
            </article>
        </main>
    </div>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "UsageTracker";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
